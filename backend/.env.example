# Environment variables for the Dhanam Store backend.
# Copy to .env for local development. Production values live in Railway's
# Variables tab — this file documents what must be set there.

# --- required ---

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DATABASE_NAME=dhanam_store

# Signing key for customer and admin sessions. The app refuses to start on the
# built-in default, because the admin token secret is derived from this one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a customer stays logged in, in hours. Defaults to 2160 (90 days).
# Left commented deliberately: it is an int, and an empty JWT_EXPIRY_HOURS=
# fails to parse and stops the app booting. Uncomment only to change it —
# every expiry costs an OTP SMS, so shortening this raises the Firebase bill.
# Admin sessions are separate and fixed at 24 hours in admin_auth.py.
# JWT_EXPIRY_HOURS=2160

# Firebase service account JSON, on a single line. Phone login verifies the
# client's Firebase ID token against this, so login fails without it.
# Generate from the downloaded key file with:
#   python -c "import json;print(json.dumps(json.load(open('firebase-credentials.json'))))"
FIREBASE_CREDENTIALS=

# --- delivery area ---

# Pincodes the shop delivers to, as a JSON list. Orders for anywhere else are
# refused at checkout. Leave empty to accept orders from anywhere, which is
# rarely what a local shop wants.
#
# Hosur, Krishnagiri district, Tamil Nadu:
#   635109  Hosur town, Hosur East, Avalapalli, Basthi, Bukkasagaram,
#           Chennathur, Doripalli, Kamandoddi and 8 more
#   635110  Hosur Cattle Farm, Achettipalli, Gopanapalli, Muduganapalli,
#           Mugalur, Nagondapalli, Panchakshipuram
#   635126  Hosur Industrial Complex, Begepalli, Mookandapalli
DELIVERY_PINCODES=["635109","635110","635126"]

# --- optional ---

# Where runtime uploads are written. In production this is a mounted volume,
# so admin-uploaded product photos survive a deploy. Without it they are
# written to the container filesystem and lost on the next push.
UPLOAD_DIR=/data/uploads

# Error reporting. Inactive when empty.
SENTRY_DSN=

# Allowed browser origins, as a JSON list. Empty means same-origin only, which
# is correct: the admin panel is served by this app and the mobile client does
# not enforce CORS.
CORS_ORIGINS=[]

# Returns OTPs in API responses and relaxes the JWT_SECRET check.
# Never enable in production.
DEBUG=false
